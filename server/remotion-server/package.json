{
  "name": "remotion-render-server",
  "version": "1.0.0",
  "description": "ContentMaster AI - Remotion 视频渲染 HTTP 服务",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "postinstall": "node -e \"const fs=require('fs');try{const p='node_modules/ffmpeg-static/ffmpeg';if(fs.existsSync(p)){fs.chmodSync(p,0o755);console.log('chmod +x ffmpeg OK');}}catch(e){console.warn('postinstall:',e.message);}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@remotion/bundler": "^4.0.250",
    "@remotion/renderer": "^4.0.250",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "mpg123-decoder": "^1.0.3",
    "multer": "^2.2.0",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
